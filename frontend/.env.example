# Backend URL used by the Next.js proxy (server-side only).
# All browser API calls are routed through /api/* on the Next.js server,
# which proxies them to this URL. Required in production.
BACKEND_URL=http://localhost:5000

# Optional: override the Axios baseURL for direct backend access.
# Remove or leave unset to use the built-in proxy (recommended).
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
