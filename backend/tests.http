@baseUrl = http://localhost:5000
@token = REPLACE_WITH_USER_JWT
@adminToken = REPLACE_WITH_ADMIN_JWT
@supplementId = REPLACE_WITH_SUPPLEMENT_ID
@complementId = REPLACE_WITH_COMPLEMENT_ID
@foodId = REPLACE_WITH_FOOD_ID

### Health check
GET {{baseUrl}}/api/health
# Expected: 200 { success: true, data: { status: "ok" } }

### Health check (POST)
POST {{baseUrl}}/api/health
# Expected: 200 { success: true, data: { status: "ok" } }

### Register user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "taha.demo@example.com",
  "password": "Password123",
  "name": "Taha Demo"
}
# Expected: 201 { success: true, data: { user, token } }

### Register duplicate user (should fail)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "taha.demo@example.com",
  "password": "Password123",
  "name": "Taha Demo"
}
# Expected: 409 { success: false, error: "User already exists" }

### Login user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "taha.demo@example.com",
  "password": "Password123"
}
# Expected: 200 { success: true, data: { user, token } }

### Login with invalid credentials (should fail)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "taha.demo@example.com",
  "password": "WrongPassword123"
}
# Expected: 401 { success: false, error: "Invalid credentials" }

### Profile with token
GET {{baseUrl}}/api/auth/profile
Authorization: Bearer {{token}}
# Expected: 200 { success: true, data: { user } }

### Profile without token (should fail)
GET {{baseUrl}}/api/auth/profile
# Expected: 401 { success: false, error: "Missing authorization token" }

### Supplements list
GET {{baseUrl}}/api/supplements
# Expected: 200 { success: true, data: [], pagination: {...} }

### Supplements search
GET {{baseUrl}}/api/supplements?search=protein
# Expected: 200 { success: true, data: [...] }

### Supplements filter by category
GET {{baseUrl}}/api/supplements?category=proteins
# Expected: 200 { success: true, data: [...] }

### Supplements pagination
GET {{baseUrl}}/api/supplements?page=1&limit=10
# Expected: 200 { success: true, data: [...], pagination: {...} }

### Supplement by ID
GET {{baseUrl}}/api/supplements/{{supplementId}}
# Expected: 200 { success: true, data: {...} }

### Toggle supplement favorite
POST {{baseUrl}}/api/supplements/{{supplementId}}/favorite
Authorization: Bearer {{token}}
# Expected: 200 { success: true, data: { user } }

### Create supplement (admin only)
POST {{baseUrl}}/api/supplements
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Hydrolyzed Whey Protein",
  "category": "proteins",
  "description": "Ultra-fast hydrolyzed whey protein for rapid amino delivery and recovery support after training sessions.",
  "benefits": ["Fast absorption", "Supports muscle recovery"],
  "dosage": "25-30g per serving",
  "timing": "Post-workout",
  "duration": "Daily",
  "ingredients": ["Hydrolyzed whey protein isolate"],
  "contraindications": ["Milk allergy"],
  "scientificStudies": [
    {
      "title": "Hydrolyzed whey and muscle recovery",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=hydrolyzed+whey+recovery",
      "summary": "Hydrolyzed whey may accelerate amino acid availability post-exercise."
    }
  ],
  "images": ["https://placehold.co/800x600?text=Hydrolyzed+Whey"],
  "goals": ["mass", "endurance"],
  "popularity": 10
}
# Expected: 201 { success: true, data: {...} }

### Complements list
GET {{baseUrl}}/api/complements
# Expected: 200 { success: true, data: [], pagination: {...} }

### Complements filter by category
GET {{baseUrl}}/api/complements?category=vitamin
# Expected: 200 { success: true, data: [...] }

### Complement by ID
GET {{baseUrl}}/api/complements/{{complementId}}
# Expected: 200 { success: true, data: {...} }

### Foods list
GET {{baseUrl}}/api/foods
# Expected: 200 { success: true, data: [], pagination: {...} }

### Top protein sources
GET {{baseUrl}}/api/foods/rankings/proteins
# Expected: 200 { success: true, data: [...] }

### Top carb sources
GET {{baseUrl}}/api/foods/rankings/carbs
# Expected: 200 { success: true, data: [...] }

### Top fat sources
GET {{baseUrl}}/api/foods/rankings/fats
# Expected: 200 { success: true, data: [...] }

### Food by ID
GET {{baseUrl}}/api/foods/{{foodId}}
# Expected: 200 { success: true, data: {...} }

### Chat - Creatine question
POST {{baseUrl}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "What is creatine?"
}
# Expected: 200 { success: true, data: { response, links, sources } }

### Chat - Protein foods question
POST {{baseUrl}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "Which foods are high in protein?"
}
# Expected: 200 { success: true, data: { response, links, sources } }

### Chat - Vitamin D question
POST {{baseUrl}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "How much vitamin D should I take?"
}
# Expected: 200 { success: true, data: { response, links, sources } }

### Chat history
GET {{baseUrl}}/api/chat/history
Authorization: Bearer {{token}}
# Expected: 200 { success: true, data: [...] }

### Clear chat history
DELETE {{baseUrl}}/api/chat/history
Authorization: Bearer {{token}}
# Expected: 200 { success: true, data: null }
